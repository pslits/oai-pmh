{
    "name": "pslits/oai-pmh",
    "description": "OAI-PMH protocol implementation in PHP",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Paul Slits",
            "email": "paul.slits@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "OaiPmh\\": "src/",
            "OaiPmh\\Protocol\\": "src/Protocol/",
            "OaiPmh\\Repository\\": "src/Repository/",
            "OaiPmh\\MetadataSerialization\\": "src/MetadataSerialization/",
            "OaiPmh\\AccessControl\\": "src/AccessControl/",
            "OaiPmh\\FlowControl\\": "src/FlowControl/",
            "OaiPmh\\Observability\\": "src/Observability/",
            "OaiPmh\\Configuration\\": "src/Configuration/",
            "OaiPmh\\Infrastructure\\": "src/Infrastructure/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OaiPmh\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    }
}